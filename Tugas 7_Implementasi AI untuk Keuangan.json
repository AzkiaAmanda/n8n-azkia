    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst today = new Date();\ntoday.setHours(23, 59, 59, 999);\n\nconst sevenDaysAgo = new Date(today);\nsevenDaysAgo.setDate(today.getDate() - 7);\nsevenDaysAgo.setHours(0, 0, 0, 0);\n\nlet formattedString = \"Data pengeluaran saya 7 hari terakhir:\\n\\n\";\nlet hasExpenses = false;\n\nfor (const item of items) {\n  const rawDate = item.json[\"Tanggal\"] || item.json[\"tanggal\"];\n  if (!rawDate) continue;\n\n  const parts = rawDate.split(\"/\");\n  if (parts.length !== 3) continue;\n\n  const day = parseInt(parts[0], 10);\n  const month = parseInt(parts[1], 10) - 1;\n  const year = parseInt(parts[2], 10);\n  const expenseDate = new Date(year, month, day);\n\n  if (expenseDate >= sevenDaysAgo && expenseDate <= today) {\n    hasExpenses = true;\n    const kategori = item.json[\"Kategori\"] || item.json[\"kategori\"] || \"\";\n    const deskripsi = item.json[\"Deskripsi\"] || item.json[\"deskripsi\"] || \"\";\n    const metode = item.json[\"Metode Pembayaran\"] || item.json[\"metode\"] || \"\";\n    const penerima = item.json[\"Penerima\"] || item.json[\"penerima\"] || \"\";\n    const jumlah = item.json[\"Jumlah\"] || item.json[\"jumlah\"] || 0;\n\n    formattedString += `${rawDate} - ${kategori}\\n${deskripsi}\\nMetode: ${metode}\\nPenerima: ${penerima}\\nRp${jumlah}\\n\\n`;\n  }\n}\n\nreturn [\n  {\n    json: {\n      hasExpenses: hasExpenses,\n      promptData: formattedString\n    }\n  }\n];"
      },
