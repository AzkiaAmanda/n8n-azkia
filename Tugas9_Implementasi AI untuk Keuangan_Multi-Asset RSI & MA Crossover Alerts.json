    {
      "parameters": {
        "jsCode": "const result = $input.item.json.chart.result[0];\nconst symbol = result.meta.symbol;\nconst timestamp = result.timestamp;\nconst quote = result.indicators.quote[0];\nconst closes = quote.close.filter(val => val !== null);\n\nfunction calculateSMA(data, period) {\n  if (data.length < period) return null;\n  let sma = [];\n  for (let i = period - 1; i < data.length; i++) {\n    const slice = data.slice(i - period + 1, i + 1);\n    const sum = slice.reduce((acc, curr) => acc + curr, 0);\n    sma.push(sum / period);\n  }\n  return sma;\n}\n\nfunction calculateRSI(data, period = 14) {\n  if (data.length <= period) return null;\n  let gains = 0, losses = 0;\n  for (let i = 1; i <= period; i++) {\n    const diff = data[i] - data[i - 1];\n    if (diff >= 0) gains += diff;\n    else losses -= diff;\n  }\n  let avgGain = gains / period;\n  let avgLoss = losses / period;\n\n  for (let i = period + 1; i < data.length; i++) {\n    const diff = data[i] - data[i - 1];\n    if (diff >= 0) {\n      avgGain = (avgGain * (period - 1) + diff) / period;\n      avgLoss = (avgLoss * (period - 1)) / period;\n    } else {\n      avgGain = (avgGain * (period - 1)) / period;\n      avgLoss = (avgLoss * (period - 1) - diff) / period;\n    }\n  }\n  if (avgLoss === 0) return 100;\n  const rs = avgGain / avgLoss;\n  return 100 - (100 / (1 + rs));\n}\n\nconst ma50Arr = calculateSMA(closes, 50);\nconst ma200Arr = calculateSMA(closes, 200);\nconst rsiValue = calculateRSI(closes, 14);\n\nconst lastClose = closes[closes.length - 1];\nconst lastMA50 = ma50Arr ? ma50Arr[ma50Arr.length - 1] : null;\nconst lastMA200 = ma200Arr ? ma200Arr[ma200Arr.length - 1] : null;\n\nlet signal = \"⚪ Tidak ada sinyal saat ini\";\nif (rsiValue !== null && rsiValue < 30) {\n  signal = \"🔵 RSI Oversold (Potensi Buy)\";\n} else if (rsiValue !== null && rsiValue > 70) {\n  signal = \"🔴 RSI Overbought (Potensi Sell)\";\n} else if (lastMA50 && lastMA200 && lastMA50 > lastMA200) {\n  signal = \"🟢 Golden Cross (Buy Signal)\";\n} else if (lastMA50 && lastMA200 && lastMA50 < lastMA200) {\n  signal = \"🔻 Death Cross (Sell Signal)\";\n}\n\nreturn {\n  json: {\n    symbol: symbol,\n    lastClose: lastClose,\n    rsi: rsiValue ? rsiValue.toFixed(2) : \"N/A\",\n    ma50: lastMA50 ? lastMA50.toFixed(2) : \"N/A\",\n    ma200: lastMA200 ? lastMA200.toFixed(2) : \"N/A\",\n    signal: signal\n  }\n};"
      },
