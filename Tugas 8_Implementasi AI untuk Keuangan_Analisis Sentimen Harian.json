    {
      "parameters": {
        "jsCode": "let positive = 0;\nlet negative = 0;\nlet neutral = 0;\n\nfor (const item of items) {\n  const sentiment = item.json.Sentiment;\n  if (sentiment === 'Positive') {\n    positive++;\n  } else if (sentiment === 'Negative') {\n    negative++;\n  } else if (sentiment === 'Neutral') {\n    neutral++;\n  }\n}\n\nconst total = items.length;\nconst positivePct = total > 0 ? ((positive / total) * 100).toFixed(1) : 0;\nconst negativePct = total > 0 ? ((negative / total) * 100).toFixed(1) : 0;\nconst neutralPct = total > 0 ? ((neutral / total) * 100).toFixed(1) : 0;\n\nreturn {\n  total_berita: total,\n  positive_count: positive,\n  positive_percentage: positivePct + '%',\n  negative_count: negative,\n  negative_percentage: negativePct + '%',\n  neutral_count: neutral,\n  neutral_percentage: neutralPct + '%'\n};"
      },
