    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst postsToSend = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const row = items[i].json;\n\n  let rawDate = String(row['Scheduled Date'] || '').trim();\n  let rawTime = String(row['Scheduled Time'] || '').trim();\n\n  // Normalisasi format tanggal DD/MM/YYYY menjadi YYYY-MM-DD\n  let formattedDate = rawDate;\n  if (rawDate.includes('/')) {\n    const parts = rawDate.split('/');\n    if (parts.length === 3) {\n      formattedDate = `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;\n    }\n  }\n\n  // Masukkan item ke output tanpa terhalang filter\n  postsToSend.push({\n    json: {\n      row_number: row.row_number || (i + 2), // Mengamankan row_number untuk Task 4 & 5\n      ID: row.ID,\n      Content: row.Content,\n      ImageURL: row['Image URL'] || '',\n      ScheduledDate: formattedDate,\n      ScheduledTime: rawTime,\n      Status: row.Status || 'Pending'\n    }\n  });\n}\n\nreturn postsToSend;"
      },
