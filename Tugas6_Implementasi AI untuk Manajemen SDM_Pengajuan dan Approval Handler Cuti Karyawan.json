    {
      "parameters": {
        "jsCode": "// Durasi diambil dari Log Pengajuan (bukan dari URL) supaya tidak bisa dimanipulasi\nconst log = $('Ambil Log Request').first().json;\nconst days = parseInt(log.Durasi);\nconst employee = items[0].json;\nconst current = parseInt(employee.Saldo_Cuti);\n\nif (isNaN(days) || isNaN(current)) {\n  throw new Error('Data durasi atau saldo cuti tidak valid');\n}\nif (current < days) {\n  throw new Error(`Saldo tidak cukup saat approval (saldo ${current}, diminta ${days})`);\n}\n\nreturn [{ json: { ...employee, newBalance: current - days } }];\n"
      },
