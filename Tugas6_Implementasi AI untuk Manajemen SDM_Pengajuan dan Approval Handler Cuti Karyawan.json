    {
      "parameters": {
        "jsCode": "// Data karyawan hasil lookup (kosong jika email tidak terdaftar)\nconst employee = items[0].json;\n// Data dari form\nconst form = $('On form submission').first().json;\n\n// Hitung durasi cuti dengan Luxon (inklusif: tanggal mulai dan selesai ikut dihitung)\nconst start = DateTime.fromISO(form['Tanggal Mulai']).startOf('day');\nconst end = DateTime.fromISO(form['Tanggal Selesai']).startOf('day');\nconst duration = Math.round(end.diff(start, 'days').days) + 1;\n\nconst registered = !!employee.Email;\nconst datesValid = start.isValid && end.isValid && duration >= 1;\nconst balance = parseInt(employee.Saldo_Cuti) || 0;\nconst enough = balance >= duration;\n\nlet message = 'Saldo Cukup';\nif (!registered) message = 'Email tidak terdaftar di database karyawan';\nelse if (!datesValid) message = 'Tanggal selesai tidak boleh lebih awal dari tanggal mulai';\nelse if (!enough) message = `Sisa saldo cuti Anda (${balance} hari) tidak mencukupi untuk pengajuan ${duration} hari`;\n\nreturn [{\n  json: {\n    ...employee,\n    ...form,\n    durationRequested: datesValid ? duration : 0,\n    currentBalance: balance,\n    isApprovedSystem: registered && datesValid && enough,\n    message,\n    requestId: 'REQ-' + Date.now(),\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
