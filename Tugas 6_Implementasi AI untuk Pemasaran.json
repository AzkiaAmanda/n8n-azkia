    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet hourlyData = {};\n\n// 1. Looping semua data untuk dihitung dan diagregasi\nitems.forEach(item => {\n  let row = item.json;\n  \n  // Sesuaikan dengan nama kolom di Sheet kamu (misal: 'Jam' atau 'Jam Tayang')\n  let hour = row['Jam'] || row['Jam Tayang']; \n  let likes = parseInt(row['Likes']) || 0;\n  let comments = parseInt(row['Comments']) || 0;\n  let shares = parseInt(row['Shares']) || 0;\n\n  // 2. Rumus Pembobotan: Share x3, Comment x2, Like x1\n  let engagement = likes + (comments * 2) + (shares * 3);\n\n  // Jika jam belum ada di object, buat baru\n  if (!hourlyData[hour]) {\n    hourlyData[hour] = { count: 0, totalEngagement: 0, totalLikes: 0, totalComments: 0, totalShares: 0 };\n  }\n  \n  // Tambahkan akumulasi data pada jam tersebut\n  hourlyData[hour].count += 1;\n  hourlyData[hour].totalEngagement += engagement;\n  hourlyData[hour].totalLikes += likes;\n  hourlyData[hour].totalComments += comments;\n  hourlyData[hour].totalShares += shares;\n});\n\nlet results = [];\n\n// 3. Hitung rata-rata per jam\nfor (let hour in hourlyData) {\n  let data = hourlyData[hour];\n  results.push({\n    json: {\n      Jam: hour,\n      AvgEngagement: Math.round(data.totalEngagement / data.count),\n      AvgLikes: Math.round(data.totalLikes / data.count),\n      AvgComments: Math.round(data.totalComments / data.count),\n      AvgShares: Math.round(data.totalShares / data.count),\n      TotalPost: data.count\n    }\n  });\n}\n\n// 4. Urutkan dari Engagement terbesar ke terkecil\nresults.sort((a, b) => b.json.AvgEngagement - a.json.AvgEngagement);\n\n// 5. Ambil (Slice) 5 jam terbaik saja\nreturn results.slice(0, 5);"
      },
