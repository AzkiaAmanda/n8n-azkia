    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items || items.length === 0) {\n    return [{ json: { message: \"❌ Tidak ada data untuk dikirim\" } }];\n}\n\n// Menggunakan Emoji dan Bold Text (*)\nlet message = \"📊 *HASIL ANALISIS WAKTU POSTING TERBAIK* 📊\\n\\n\";\nmessage += \"🏆 *TOP 5 JAM TERBAIK:*\\n\\n\";\n\nitems.forEach((item, index) => {\n    let data = item.json;\n    // Logika medali untuk peringkat 1, 2, 3\n    let rank = index === 0 ? '🥇' : (index === 1 ? '🥈' : (index === 2 ? '🥉' : '⭐'));\n    \n    message += `${rank} *JAM ${data.Jam}*\\n`;\n    message += `📈 Avg Engagement: ${data.AvgEngagement}\\n`;\n    message += `👍 Likes: ${data.AvgLikes} | 💬 Comments: ${data.AvgComments} | 🔁 Shares: ${data.AvgShares}\\n`;\n    message += `📝 Berdasarkan ${data.TotalPost} post\\n`;\n    \n    // Ajakan / label khusus untuk Top 3\n    if (index < 3) {\n         message += `🔥 _SANGAT DIREKOMENDASIKAN_\\n`;\n    }\n    message += `\\n`;\n});\n\nmessage += \"🚀 _Gunakan insight ini untuk jadwal posting selanjutnya!_\";\n\nreturn [{ json: { message: message } }];"
      },
